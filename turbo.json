{
  "extends": ["//"],
  "tasks": {
    "test": {
      "outputs": [],
      "env": ["ETH_PRIVATE_KEY", "ETH_KEYSTORE_PASSWORD"]
    },
    "generate": {
      "inputs": ["src/**/*.json", "scripts/**/*.ts"]
    },
    "build": {
      "dependsOn": [],
      "inputs": [
        "src/**/*.ts",
        "build.ts",
        "$TURBO_ROOT$/build-declarations.ts",
        "$TURBO_ROOT$/build.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": ["dist/**"],
      "env": [
        "PUBLIC_ERC8128_ALCHEMY_ID",
        "ETH_PRIVATE_KEY",
        "ETH_KEYSTORE_PASSWORD",
        "DEBUG",
        "WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING",
        "DATABASE_URL"
      ]
    }
  }
}
