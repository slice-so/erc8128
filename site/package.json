{
  "name": "@slicekit/erc8128-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "cd .. && bun run build.ts",
    "predev": "cd .. && bun run build.ts",
    "dev": "astro build && wrangler dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "astro": "astro",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config=drizzle.config.ts",
    "db:cleanup": "wrangler dev --test-scheduled",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@coinbase/wallet-sdk": "^4.3.6",
    "@slicekit/erc8128": "^0.4.0",
    "@tanstack/react-query": "catalog:",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "astro": "catalog:",
    "connectkit": "catalog:",
    "drizzle-orm": "~0.41.0",
    "hono": "catalog:",
    "porto": "catalog:",
    "postgres": "~3.4.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "viem": "^2.48.0",
    "wagmi": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.1.18",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "satori": "catalog:",
    "tailwindcss": "~4.1.18",
    "wrangler": "catalog:"
  }
}
