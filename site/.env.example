# ERC-8128 site env.

# Scope: public site config.
PUBLIC_ERC8128_ALCHEMY_ID=

# Scope: site storage.
DATABASE_URL= # optional if Hyperdrive or WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING is configured
REDIS_URL=
ERC8128_STORAGE_MODE=postgres
ERC8128_DEV_STORAGE_OVERRIDE=false # optional local-only debug backend override

# Scope: server verification RPC.
ERC8128_SECRET_ALCHEMY_ID=
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING= # optional if DATABASE_URL is set
