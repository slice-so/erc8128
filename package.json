{
  "name": "@slicekit/erc8128",
  "version": "0.4.1",
  "description": "Minimal ERC-8128 implementation for signing and verifying HTTP requests with Ethereum accounts",
  "scripts": {
    "type-check": "tsc -p tsconfig.json --noEmit && bun run --cwd cli type-check && bun run --cwd site type-check",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "build": "bun run build.ts",
    "test": "bun test ./src ./cli/src ./site/src"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "slice-so",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "./dist",
    "./LICENSE-MIT",
    "./LICENSE-APACHE"
  ],
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "viem": "^2.48.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.11",
    "@types/node": "~25.6.2",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "astro": "^5.17.1",
    "commander": "^14.0.0",
    "connectkit": "~1.9.2",
    "drizzle-kit": "~0.31.10",
    "drizzle-orm": "~0.41.0",
    "hono": "~4.12.18",
    "porto": "^0.2.37",
    "postgres": "~3.4.7",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "satori": "^0.12.0",
    "wagmi": "^3.6.11",
    "wrangler": "^4.66.0",
    "typescript": "6.0.3",
    "bun-types": "1.4.0",
    "@biomejs/biome": "^2.4.15",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1"
  },
  "peerDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/slice-so/erc8128"
  },
  "homepage": "https://erc8128.org",
  "keywords": [
    "http",
    "ethereum",
    "wallet",
    "web3",
    "dapp",
    "dappkit"
  ],
  "packageManager": "bun@1.4.0"
}
